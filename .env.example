# Copy to .env and fill in. Never commit real secrets.

# Public URL of the app. Cookies get the Secure flag when this is https.
BASE_URL=http://localhost:8080
# Address to listen on.
LISTEN_ADDR=:8080
# SQLite database file. Use a path on a persistent volume in production.
DB_PATH=opentripsplit.db

# How long a login lasts, and how long invite links stay valid (Go durations).
SESSION_TTL=720h
INVITE_TTL=168h

# Dev only: password-less login with test users Alice/Bob/Casey. Refused
# unless BASE_URL is localhost. NEVER enable in production.
DEV_LOCAL_AUTH=false

# Login providers. All optional: anything not set here can be configured in
# the browser at /setup (first run) or /admin. Values here take precedence.
# Callback URL: $BASE_URL/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Callback URL: $BASE_URL/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
