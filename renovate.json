{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
        "customType": "regex",
        "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
        "matchStrings": [
            "uses:\\s*(?<depName>SecObserve/secobserve_actions_templates)/[^@\\s]+@(?<currentDigest>[a-f0-9]{40})\\s+#\\s*(?<currentValue>v\\d{4}_\\d{2}(?:_\\d+)?)"
        ],
        "datasourceTemplate": "github-tags",
        "versioningTemplate": "regex:^v(?<major>\\d{4})_(?<minor>\\d{2})(?:_(?<patch>\\d+))?$"
    }
  ]
}
