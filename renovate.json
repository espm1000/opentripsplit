{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
      {
          "matchUpdateTypes": [
              "minor",
              "patch"
          ],
          "groupName": "minor and patch",
          "groupSlug": "all-minor-patch",
          "matchPackageNames": [
              "*"
          ]
      },
      {
          "groupName": "terraform",
          "groupSlug": "terraform",
          "matchPackageNames": [
              "/terraform/"
          ]
      },
      {
          "matchDatasources": ["pypi"],
          "matchManagers": ["pip_requirements"],
          "groupName": "Python-pip Dependencies"
      }
  ]
}
